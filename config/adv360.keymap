#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1    &kp N2   &kp N3    &kp N4     &kp N5  &kp C_NEXT                                                   &kp C_VOLUME_UP    &kp N6  &kp N7    &kp N8        &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q     &kp W    &kp E     &kp R      &kp T   &kp C_PREV                                                   &kp C_VOLUME_DOWN  &kp Y   &kp U     &kp I         &kp O     &kp P     &kp BSLH
&kp ESC    &kp A     &kp S    &kp D     &kp F      &kp G   &kp C_PP    &kp LEFT_ALT    &mo 4      &mo 4  &kp RIGHT_ALT  &kp C_MUTE         &kp H   &kp J     &kp K         &kp L     &kp SEMI  &kp SQT
&kp DEL    &kp Z     &kp X    &kp C     &kp V      &kp B                               &none      &none                                    &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH  &kp EQUAL
&none      &kp HOME  &kp END  &kp LEFT  &kp RIGHT          &kp BSPC    &kp LEFT_SHIFT  &none      &none  &kp SPACE      &kp ENTER                  &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT  &none
            >;
        };

        mac_base {
            display-name = "White";
            bindings = <
&trans         &trans  &trans  &trans  &trans  &trans  &trans                                                           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans  &trans  &trans  &trans  &trans  &trans                                                           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo 5                 &mo 6              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans  &trans  &trans  &trans  &trans                  &kp LCTRL             &kp RCTRL                          &trans  &trans  &trans  &trans  &trans  &trans
&kp LG(GRAVE)  &trans  &trans  &trans  &trans          &trans  &trans  &kp LEFT_COMMAND      &kp RIGHT_COMMAND  &trans  &trans          &trans  &trans  &trans  &trans  &kp LS(LG(NUMBER_4))
            >;
        };

        win_base {
            display-name = "Blue";
            bindings = <
&trans       &trans  &trans  &trans  &trans  &trans  &trans                                                   &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans                                                   &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo 3             &mo 7          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans                  &kp LEFT_WIN      &kp RIGHT_WIN                  &trans  &trans  &trans  &trans  &trans  &trans
&kp LA(TAB)  &trans  &trans  &trans  &trans          &trans  &trans  &kp LCTRL         &kp RCTRL      &trans  &trans          &trans  &trans  &trans  &trans  &kp LC(PRINTSCREEN)
            >;
        };

        win_keypad {
            display-name = "Green";
            bindings = <
&none       &none  &none  &none  &none  &none  &to 2                                                    &to 1         &none  &kp KP_NUM       &kp KP_EQUAL     &kp KP_DIVIDE    &kp KP_MULTIPLY  &none
&none       &none  &none  &none  &none  &none  &none                                                    &none         &none  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS     &none
&none       &none  &none  &none  &none  &none  &to 4          &none  &none      &mo 8  &none            &to 4         &none  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &none
&kp DELETE  &none  &none  &none  &none  &none                        &none      &none                                 &none  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER     &none
&none       &none  &none  &none  &none         &kp BACKSPACE  &none  &none      &none  &kp KP_NUMBER_0  &kp KP_ENTER         &kp PAGE_DOWN    &kp PAGE_UP      &kp KP_DOT       &none            &kp LC(PRINTSCREEN)
            >;
        };

        mod_layer {
            display-name = "Red";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to 2                                             &to 1        &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                       &bootloader  &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &none       &none  &none        &none  &none       &none       &none  &none  &none
&bt BT_CLR      &none         &none         &none         &none         &none                             &none      &none                           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &bl BL_TOG  &none  &none               &bl BL_DEC  &bl BL_INC  &none  &none  &none
            >;
        };

        mac_keypad {
            display-name = "Purple";
            bindings = <
&none    &none  &none  &none  &none  &none  &to 2                                                    &to 1         &none  &kp KP_NUM       &kp KP_EQUAL     &kp KP_DIVIDE    &kp KP_MULTIPLY  &none
&none    &none  &none  &none  &none  &none  &none                                                    &none         &none  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS     &none
&none    &none  &none  &none  &none  &none  &to 4          &none  &none      &mo 9  &none            &to 4         &none  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &none
&kp DEL  &none  &none  &none  &none  &none                        &none      &none                                 &none  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER     &none
&none    &none  &none  &none  &none         &kp BACKSPACE  &none  &none      &none  &kp KP_NUMBER_0  &kp KP_ENTER         &kp PAGE_DOWN    &kp PAGE_UP      &kp KP_DOT       &none            &kp LS(LG(NUMBER_5))
            >;
        };

        mac_function {
            display-name = "Aquamarine";
            bindings = <
&none        &kp F1      &kp F2          &kp F3           &kp F4             &kp F5  &to 2                                  &to 1  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&none        &kp INSERT  &kp SCROLLLOCK  &kp PAUSE_BREAK  &none              &none   &none                                  &none  &none   &none   &none   &none   &none    &kp F12
&none        &none       &none           &none            &none              &none   &to 4  &none  &mo 9      &none  &none  &to 4  &none   &none   &none   &none   &none    &none
&none        &none       &none           &none            &none              &none                 &none      &none                &none   &none   &none   &none   &none    &none
&kp LG(TAB)  &none       &none           &kp LC(PG_UP)    &kp LC(PAGE_DOWN)          &none  &none  &none      &none  &none  &none          &none   &none   &none   &none    &none
            >;
        };

        win_function {
            display-name = "Yellow";
            bindings = <
&none        &kp F1      &kp F2          &kp F3           &kp F4             &kp F5  &to 2                                  &to 1  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&none        &kp INSERT  &kp SCROLLLOCK  &kp PAUSE_BREAK  &none              &none   &none                                  &none  &none   &none   &none   &none   &none    &kp F12
&none        &none       &none           &none            &none              &none   &to 4  &none  &mo 8      &none  &none  &to 4  &none   &none   &none   &none   &none    &none
&none        &none       &none           &none            &none              &none                 &none      &none                &none   &none   &none   &none   &none    &none
&kp LG(TAB)  &none       &none           &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)          &none  &none  &none      &none  &none  &none          &none   &none   &none   &none    &none
            >;
        };

        win_transition {
            display-name = "(no-color)";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                    &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                                    &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &tog 3      &tog 7  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none       &none                 &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none         &none  &none  &none       &none   &none  &none         &none  &none  &none  &none  &none
            >;
        };

        mac_transition {
            display-name = "(no-color)";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                    &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                                    &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &tog 5      &tog 6  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none       &none                 &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none         &none  &none  &none       &none   &none  &none         &none  &none  &none  &none  &none
            >;
        };
    };
};
